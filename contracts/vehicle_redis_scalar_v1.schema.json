{
  "title": "Vehicle Redis scalar messages v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "receipt": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "monotonic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "media_pts": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frame_index",
        "ts",
        "monotonic",
        "media_pts"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "task": {
          "enum": [
            "classify"
          ]
        }
      },
      "required": [
        "model_name",
        "version",
        "task"
      ],
      "additionalProperties": false
    },
    "detector": {
      "type": "object",
      "properties": {
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "task": {
          "enum": [
            "detect"
          ]
        }
      },
      "required": [
        "model_name",
        "version",
        "task"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "org_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "camera_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "camera_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valid_from": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_kind": {
          "enum": [
            "file",
            "rtsp"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detector": {
          "$ref": "#/$defs/detector"
        },
        "resolution_provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "org_id",
        "camera_id",
        "camera_timezone",
        "valid_from",
        "valid_to",
        "run_id",
        "source_kind",
        "started_at",
        "service_version",
        "detector",
        "resolution_provenance"
      ],
      "additionalProperties": false
    },
    "life": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "service_track_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "tracker_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775806
        },
        "raw_track_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "lifetime_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "first": {
          "$ref": "#/$defs/receipt"
        },
        "last": {
          "$ref": "#/$defs/receipt"
        },
        "frames_observed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "closure": {
          "enum": [
            "track_loss",
            "tracker_reset",
            "camera_outage",
            "end_of_input",
            "service_stop",
            "clock_discontinuity",
            "process_error"
          ]
        },
        "quarantined": {
          "type": "boolean"
        }
      },
      "required": [
        "context",
        "service_track_id",
        "tracker_epoch",
        "raw_track_id",
        "lifetime_sequence",
        "first",
        "last",
        "frames_observed",
        "closure",
        "quarantined"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "monotonic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "media_pts": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "$ref": "#/$defs/model"
        },
        "quality_algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "attempt_id",
        "frame_index",
        "ts",
        "monotonic",
        "media_pts",
        "algorithm",
        "quality_algorithm",
        "label",
        "confidence",
        "quality"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 128
        },
        "reason": {
          "enum": [
            "short_unknown",
            "short_lock",
            "final_unknown",
            "final_lock"
          ]
        }
      },
      "required": [
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "decided",
            "undecided"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "support": {
          "$ref": "#/$defs/receipt"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "state",
        "label",
        "confidence",
        "support",
        "model",
        "samples"
      ],
      "additionalProperties": false
    },
    "colour_result": {
      "type": "object",
      "properties": {
        "claims": {
          "$ref": "#/$defs/claims"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "claims",
        "provenance"
      ],
      "additionalProperties": false
    },
    "colour.batch": {
      "type": "object",
      "properties": {
        "life": {
          "$ref": "#/$defs/life"
        },
        "complete": {
          "const": true
        },
        "expected_attempt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 128
        }
      },
      "required": [
        "life",
        "complete",
        "expected_attempt_ids",
        "measurements"
      ],
      "additionalProperties": false
    },
    "vehicle.closed": {
      "type": "object",
      "properties": {
        "life": {
          "$ref": "#/$defs/life"
        },
        "colour_batch_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receipt": {
                "$ref": "#/$defs/receipt"
              },
              "label": {
                "enum": [
                  "car",
                  "van",
                  "bus",
                  "truck",
                  "motorcycle",
                  "bicycle",
                  "unknown"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "receipt",
              "label",
              "confidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "plate": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "manufacturer": {
          "enum": [
            "unsupported"
          ]
        }
      },
      "required": [
        "life",
        "colour_batch_id",
        "classes",
        "plate",
        "manufacturer"
      ],
      "additionalProperties": false
    },
    "colour.terminal": {
      "type": "object",
      "properties": {
        "life": {
          "$ref": "#/$defs/life"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "result": {
          "$ref": "#/$defs/colour_result"
        }
      },
      "required": [
        "life",
        "batch_id",
        "result"
      ],
      "additionalProperties": false
    },
    "db1.delivery": {
      "type": "object",
      "properties": {
        "life": {
          "$ref": "#/$defs/life"
        },
        "bundle": {
          "type": "object"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "life",
        "bundle",
        "bundle_sha256"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "vehicle-redis-scalar-v1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "org_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "kind": {
          "const": "colour.batch"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "$ref": "#/$defs/colour.batch"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "org_id",
        "kind",
        "body_sha256",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "vehicle-redis-scalar-v1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "org_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "kind": {
          "const": "vehicle.closed"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "$ref": "#/$defs/vehicle.closed"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "org_id",
        "kind",
        "body_sha256",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "vehicle-redis-scalar-v1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "org_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "kind": {
          "const": "colour.terminal"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "$ref": "#/$defs/colour.terminal"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "org_id",
        "kind",
        "body_sha256",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "vehicle-redis-scalar-v1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "org_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 36
        },
        "kind": {
          "const": "db1.delivery"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "$ref": "#/$defs/db1.delivery"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "org_id",
        "kind",
        "body_sha256",
        "body"
      ],
      "additionalProperties": false
    }
  ]
}
