{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waycon.local/contracts/db1/diagnostics.v1.schema.json",
  "title": "WAYCON DB1 minimal diagnostic sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "row_kind",
    "row_uid",
    "run_id",
    "track_id",
    "reason",
    "time_basis",
    "frame_index",
    "media_pts",
    "raw_tracker",
    "association",
    "selected",
    "error_code",
    "media_status",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "db1-diagnostics-v1"
    },
    "record_type": {
      "enum": [
        "row",
        "omission",
        "quarantine"
      ]
    },
    "row_kind": {
      "enum": [
        "fact_vehicle",
        "fact_plate_read",
        "fact_vehicle_colour",
        "fact_vehicle_make"
      ]
    },
    "row_uid": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "track_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "reason": {
      "enum": [
        "row_finalized",
        "no_detection",
        "rejected_crop",
        "ambiguous_association",
        "unassociated_crop",
        "disabled_capability",
        "unsupported_capability",
        "failure_before_model",
        "catalogue_unresolved",
        "clock_discontinuity",
        "media_unavailable",
        "unsettled_operation",
        "construction_blocked"
      ]
    },
    "time_basis": {
      "enum": [
        "host_frame_receipt",
        "host_replay_receipt"
      ]
    },
    "frame_index": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "media_pts": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_tracker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_id",
            "epoch"
          ],
          "properties": {
            "raw_id": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "association": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "candidate_track_ids",
            "selected_track_id",
            "selected_score",
            "runner_up_score",
            "profile"
          ],
          "properties": {
            "status": {
              "enum": [
                "associated",
                "ambiguous",
                "unassociated"
              ]
            },
            "candidate_track_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "selected_track_id": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "selected_score": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "runner_up_score": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "profile": {
              "const": "vehicle_plate_geometry_v0"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "selected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_uid",
            "route",
            "model_name",
            "model_version",
            "attempts",
            "samples"
          ],
          "properties": {
            "attempt_uid": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "route": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_name": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_version": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempts": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "samples": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "media_status": {
      "enum": [
        "stored",
        "unavailable",
        "not_requested"
      ]
    },
    "payload_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incomplete",
        "attempts",
        "unresolved_attempts"
      ],
      "properties": {
        "incomplete": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_attempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reason": {"const": "construction_blocked"}}},
      "then": {"properties": {"record_type": {"const": "quarantine"}}}
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "row"
          }
        }
      },
      "then": {
        "properties": {
          "row_uid": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "row_finalized",
              "media_unavailable"
            ]
          },
          "payload_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "omission"
          }
        }
      },
      "then": {
        "properties": {
          "row_uid": {
            "type": "null"
          },
          "reason": {
            "enum": [
              "no_detection",
              "rejected_crop",
              "ambiguous_association",
              "unassociated_crop",
              "disabled_capability",
              "unsupported_capability",
              "failure_before_model",
              "unsettled_operation"
            ]
          },
          "payload_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "unsettled_operation"
          }
        }
      },
      "then": {
        "required": [
          "settlement"
        ],
        "properties": {
          "record_type": {
            "const": "omission"
          },
          "row_kind": {
            "const": "fact_plate_read"
          },
          "selected": {
            "type": "null"
          },
          "settlement": {
            "properties": {
              "incomplete": {
                "const": true
              },
              "attempts": {
                "minimum": 1
              },
              "unresolved_attempts": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "settlement"
        ],
        "properties": {
          "settlement": {
            "properties": {
              "incomplete": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "unsettled_operation"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "settlement"
        ],
        "properties": {
          "settlement": {
            "properties": {
              "incomplete": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "settlement": {
            "properties": {
              "unresolved_attempts": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
