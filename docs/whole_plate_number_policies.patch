index 0000000..e111ba9
--- /dev/null
+++ b/experiments/whole_plate_policies/verify.py
@@ -0,0 +1,118 @@
+"""Real reference-crop development check using the actual serialized worker.
+
+Manifest numbers are read only for comparison after inference, never as inputs.
+"""
+import argparse
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import sys
+from unittest.mock import patch
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--flavor', choices=['django', 'standalone'], default='django')
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    package = root / ('vehicle/license_plate_service' if args.flavor == 'django' else 'services/license_plate_service')
+    sys.path.insert(0, str(package))
+    cache = root / '.runtime/plates/cache'
+    for key, value in {'TORCH_HOME': cache/'torch', 'PADDLE_PDX_CACHE_HOME': cache/'paddle',
+                       'MPLCONFIGDIR': cache/'matplotlib', 'YOLO_CONFIG_DIR': cache/'yolo'}.items():
+        os.environ[key] = str(value)
+    os.environ['PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK'] = 'True'
+    os.environ['YOLO_AUTOINSTALL'] = 'false'
+    args.output.mkdir(parents=True, exist_ok=True)
+    manifest = root/'services/license_plate_service/LicensePlatePlugin/assets/references/manifest.json'
+    references = json.loads(manifest.read_text())['images']
+    rows = []
+    with patch.object(socket.socket, 'connect', side_effect=AssertionError('network denied')) as connect, patch.object(
+        socket, 'create_connection', side_effect=AssertionError('network denied')
+    ) as connection:
+        import cv2
+        from PIL import Image, ImageDraw, ImageOps
+        from run_video_pipeline import config
+        from run_video_pipeline.classification import create_classifier
+        from run_video_pipeline.data_capture import ReviewStore
+        from run_video_pipeline.marker_localizer import TounesMarkerLocalizer
+        from run_video_pipeline.ocr import digits_only
+        from run_video_pipeline.plate_detector import PlateCrop
+        from run_video_pipeline.prototype_pipeline import PrototypePlatePipeline
+        from run_video_pipeline.run_video_prototype import CountingReader, VideoPrototypeRunner
+        reader = CountingReader()
+        pipeline = PrototypePlatePipeline(reader, TounesMarkerLocalizer(config.WORD_DETECTOR_PATH),
+                                          ReviewStore(args.output/'captures'), classifier_factory=create_classifier)
+        runner = VideoPrototypeRunner(pipeline, None, None, reader)
+        try:
+            for reference in references:
+                source = manifest.parent/reference['path']
+                assert hashlib.sha256(source.read_bytes()).hexdigest() == reference['sha256']
+                shutil.copy2(source, args.output/f"original_{reference['id']}.png")
+                image = cv2.imread(str(source))
+                crop = PlateCrop(image, (0, 0, image.shape[1], image.shape[0]), 1.0)
+                before = reader.calls
+                result = runner.executor.submit(pipeline.process_crop, crop).result()
+                # Expected annotation is compared only after actual inference returns.
+                expected_digits = digits_only(reference['registration'])
+                numeric_fields = result.registration_fields
+                inferred_digits = (numeric_fields.get('first_group', '') + numeric_fields.get('second_group', '')
+                                   if result.predicted_category == 'idara' else
+                                   numeric_fields.get('series', '') + numeric_fields.get('registration_number', ''))
+                row = {'id': reference['id'], 'expected_category': reference['category'],
+                       'expected_manifest_registration': reference['registration'],
+                       'predicted_category': result.predicted_category, 'raw_ocr': result.plate_text_raw,
+                       'ocr_score': result.text_confidence, 'extracted_fields': result.number.checks.get('extracted_fields', numeric_fields),
+                       'validated_fields': numeric_fields, 'formatted_result': result.normalized_number,
+                       'status': result.recognition_status, 'reason': result.unresolved_reason,
+                       'checks': result.number.checks, 'timing': result.timing.model_dump(),
+                       'registration_ocr_calls': reader.calls-before,
+                       'comparison': 'match' if result.status == 'accepted' and inferred_digits == expected_digits
+                                     and result.predicted_category == reference['category'] else
+                                     'mismatch' if result.status == 'accepted' else 'not_accepted'}
+                rows.append(row)
+                print(json.dumps(row, ensure_ascii=False), flush=True)
+        finally:
+            runner.close()
+        assert connect.call_count == connection.call_count == 0
+    report = {'independent_accuracy_evaluation': False, 'flavor': args.flavor,
+              'scope': '12 reused development/gallery reference crops', 'network_attempts': 0,
+              'whole_plate_threshold': config.WHOLE_PLATE_MIN_OCR_CONF, 'results': rows}
+    (args.output/'results.json').write_text(json.dumps(report, ensure_ascii=False, indent=2))
+    with (args.output/'comparison.csv').open('w', newline='') as stream:
+        fields = ['id', 'expected_category', 'expected_manifest_registration', 'predicted_category', 'raw_ocr',
+                  'ocr_score', 'extracted_fields', 'formatted_result', 'status', 'reason', 'comparison']
+        writer = csv.DictWriter(stream, fieldnames=fields, extrasaction='ignore')
+        writer.writeheader(); writer.writerows(rows)
+    lines = ['# Real OCR development comparison', '',
+             'Actual classification and registration inference on reused reference crops; not independent accuracy.', '',
+             '| ID | Category | Manifest registration | Raw OCR | Score | Fields | Formatted result | Status / reason | Comparison |',
+             '|---|---|---|---|---|---|---|---|---|']
+    sheet = Image.new('RGB', (1200, 6*190), 'white')
+    for i, row in enumerate(rows):
+        values = [row['id'], row['expected_category'], row['expected_manifest_registration'], row['raw_ocr'],
+                  f"{row['ocr_score']:.6f}", json.dumps(row['extracted_fields'], ensure_ascii=False),
+                  row['formatted_result'] or '', row['status'] + (' / '+row['reason'] if row['reason'] else ''), row['comparison']]
+        lines.append('| ' + ' | '.join(str(v).replace('|', '\\|').replace('\n', ' ') for v in values) + ' |')
+        preview = Image.new('RGB', (600, 190), 'white')
+        draw = ImageDraw.Draw(preview)
+        draw.text((8, 5), f"Reference {row['id']} | {row['expected_category']} | {row['status']} | {row['comparison']}", fill='black')
+        image = Image.open(args.output/f"original_{row['id']}.png").convert('RGB')
+        image.thumbnail((570, 110)); preview.paste(image, (8, 28))
+        # ASCII registration display is legible without requiring an Arabic font.
+        display = row['formatted_result'] if row['expected_category'] != 'tunis' else str(row['validated_fields'])
+        draw.text((8, 145), f"Output: {display or row['reason']} | score {row['ocr_score']:.4f}", fill='black')
+        preview.save(args.output/f"preview_{row['id']}.png")
+        sheet.paste(preview, ((i%2)*600, (i//2)*190))
+    sheet.save(args.output/'contact_sheet.png')
+    (args.output/'REPORT.md').write_text('\n'.join(lines)+'\n')
+    print(f'Results: {args.output}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
