+"""Bounded real verification with socket denial. Outputs are not an independent evaluation."""
+import argparse
+import json
+import os
+from pathlib import Path
+import socket
+import sys
+import time
+import resource
+from unittest.mock import patch
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def run(args):
+    started = time.perf_counter()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    if args.mode == 'crops':
+        sys.path.insert(0, str(REPO / 'services/license_plate_service'))
+        from run_video_pipeline.classification import create_classifier
+        from run_video_pipeline.data_capture import ReviewStore
+        from run_video_pipeline.marker_localizer import TounesMarkerLocalizer
+        from run_video_pipeline import config
+        from run_video_pipeline.plate_detector import PlateCrop
+        from run_video_pipeline.prototype_pipeline import PrototypePlatePipeline
+        from run_video_pipeline.run_video_prototype import CountingReader, VideoPrototypeRunner, TrackState
+        from run_video_pipeline.policies import compact_result
+        from license_plate_plugin import load_default_config
+        from license_plate_plugin.manifest import load_reference_manifest
+        reader = CountingReader()
+        pipeline = PrototypePlatePipeline(reader, TounesMarkerLocalizer(config.WORD_DETECTOR_PATH),
+                                          ReviewStore(output/'captures'), classifier_factory=create_classifier)
+        initialization = time.perf_counter()
+        runner = VideoPrototypeRunner(pipeline, None, None, reader, max_pending=2)
+        initialized_ms = (time.perf_counter()-initialization)*1000
+        records, _ = load_reference_manifest(load_default_config().reference_manifest)
+        try:
+            for record in records:
+                image = record['image']
+                state = TrackState(int(record['id']), 0, 0)
+                state.consider(PlateCrop(image, (0, 0, image.shape[1], image.shape[0]), 1.0), 0)
+                runner.tracks[state.track_id] = state
+                runner._submit(state, str(record['path']), 'real_crop_verification')
+            runner.finish('crop_verification')
+        finally:
+            runner.close()
+        rows = []
+        for record in records:
+            state = runner.tracks[int(record['id'])]
+            result = state.final_result
+            rows.append({'id': record['id'], 'expected_category': record['category'],
+                         'expected_registration_annotation': record.get('registration'), **compact_result(result)})
+        summary = {'mode': 'development_reference_crops', 'independent_evaluation': False,
+                   'initialization_ms': initialized_ms, 'results': rows, 'deferred_events': runner.deferred_events,
+                   'queue_capacity': runner.max_pending}
+    elif args.mode == 'standalone':
+        sys.path.insert(0, str(REPO/'services/license_plate_service'))
+        from run_video_pipeline.run_video_prototype import main as video_main
+        metrics = output/'metrics.json'
+        sys.argv = ['local-video', str(args.video), '--max-frames', str(args.frames),
+                    '--output', str(output/'annotated.mp4'), '--metrics-output', str(metrics),
+                    '--capture-root', str(output/'captures'), '--selected-crops-dir', str(output/'selected_crops')]
+        if video_main() != 0:
+            raise RuntimeError('Standalone video failed')
+        summary = {'mode': 'standalone_video', 'result': json.loads(metrics.read_text())}
+    else:
+        sys.path.insert(0, str(REPO/'vehicle'))
+        os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'vehicle.settings')
+        import django
+        django.setup()
+        from django.test import Client, override_settings
+        with override_settings(MEDIA_ROOT=output/'media', ALLOWED_HOSTS=['testserver']):
+            with args.video.open('rb') as handle:
+                response = Client().post('/api/license-plate/analyze/', {'video': handle, 'max_frames': str(args.frames)})
+            summary = {'mode': 'django_upload', 'http_status': response.status_code, 'result': response.json()}
+            if response.status_code != 200:
+                raise RuntimeError(summary)
+    summary['elapsed_seconds'] = time.perf_counter()-started
+    summary['peak_rss_bytes'] = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024
+    return summary
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--mode', choices=['crops', 'django', 'standalone'], required=True)
+    parser.add_argument('--video', type=Path, default=REPO/'services/license_plate_service/run_video_pipeline/test_video.mp4')
+    parser.add_argument('--frames', type=int, default=30)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    with patch.object(socket.socket, 'connect', side_effect=AssertionError('network denied')) as connect, patch.object(
+        socket, 'create_connection', side_effect=AssertionError('network denied')
+    ) as create:
+        summary = run(args)
+        if connect.call_count or create.call_count:
+            raise AssertionError('A runtime network connection was attempted')
+    summary['network_attempts'] = 0
+    args.output.mkdir(parents=True, exist_ok=True)
+    (args.output/'verification.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2))
+    print(json.dumps({'mode': summary['mode'], 'elapsed_seconds': summary['elapsed_seconds'], 'network_attempts': 0}))
+
+
+if __name__ == '__main__':
+    main()
