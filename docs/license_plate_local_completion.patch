+#!/usr/bin/env bash
+# Provision a dedicated persistent runtime; never modifies another project's environment.
+set -euo pipefail
+REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+RUNTIME_DIR="${PLATE_RUNTIME_DIR:-$REPO_DIR/.runtime/plates}"
+PYTHON_BIN="${PLATE_PYTHON:-python3.11}"
+"$PYTHON_BIN" -m venv --system-site-packages "$RUNTIME_DIR/venv"
+# Optional explicit reuse of an existing persistent host CV installation.
+# Without this option install the complete backend requirements in the new environment.
+if [[ -n "${PLATE_BASE_SITE_PACKAGES:-}" ]]; then
+  "$RUNTIME_DIR/venv/bin/python" - "$RUNTIME_DIR" "$PLATE_BASE_SITE_PACKAGES" <<'PY'
+from pathlib import Path
+import sys, sysconfig
+source = Path(sys.argv[2]).resolve(strict=True)
+Path(sysconfig.get_path('purelib'), 'plate_host_cv.pth').write_text(str(source) + '\n')
+PY
+  "$RUNTIME_DIR/venv/bin/python" -m pip install -r "$REPO_DIR/services/license_plate_service/requirements-classifier.txt"
+else
+  "$RUNTIME_DIR/venv/bin/python" -m pip install -r "$REPO_DIR/vehicle/requirements.txt"
+fi
+"$RUNTIME_DIR/venv/bin/python" -m pip install --no-deps --no-build-isolation -e "$REPO_DIR/services/license_plate_service/LicensePlatePlugin"
+mkdir -p "$RUNTIME_DIR/cache/torch" "$RUNTIME_DIR/cache/paddle" "$RUNTIME_DIR/cache/matplotlib" "$RUNTIME_DIR/cache/yolo"
+echo "Persistent runtime: $RUNTIME_DIR/venv/bin/python"
+echo 'Set REGISTRATION_OCR_MODEL_DIR to installed PP-OCRv6_medium_rec assets before recognition.'
