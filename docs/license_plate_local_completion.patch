+#!/usr/bin/env bash
+set -euo pipefail
+REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+RUNTIME_DIR="${PLATE_RUNTIME_DIR:-$REPO_DIR/.runtime/plates}"
+export TORCH_HOME="$RUNTIME_DIR/cache/torch"
+export PADDLE_PDX_CACHE_HOME="$RUNTIME_DIR/cache/paddle"
+export MPLCONFIGDIR="$RUNTIME_DIR/cache/matplotlib"
+export YOLO_CONFIG_DIR="$RUNTIME_DIR/cache/yolo"
+export PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
+export YOLO_AUTOINSTALL=false
+export PYTHONDONTWRITEBYTECODE=1
+COMMAND="${1:?Use django, video, rtsp, or verify}"
+shift
+case "$COMMAND" in
+ django) exec "$RUNTIME_DIR/venv/bin/python" -B "$REPO_DIR/vehicle/manage.py" "$@" ;;
+ video|rtsp)
+  cd "$REPO_DIR/services/license_plate_service"
+  exec "$RUNTIME_DIR/venv/bin/python" -B -m "run_${COMMAND}_pipeline.run_${COMMAND}_prototype" "$@" ;;
+ verify) exec "$RUNTIME_DIR/venv/bin/python" -B "$REPO_DIR/scripts/verify_local_plate.py" "$@" ;;
+ *) echo "Unknown command $COMMAND" >&2; exit 2 ;;
+esac
