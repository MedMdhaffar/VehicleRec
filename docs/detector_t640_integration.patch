+"""Detector-only post-warm-up CPU/GPU-provider timing; no recognition imports."""
+import argparse
+import json
+from pathlib import Path
+import resource
+import socket
+import statistics
+import sys
+import time
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'vehicle/license_plate_service'))
+import cv2
+from run_video_pipeline.plate_detector import PlateDetector
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--repeats',type=int,default=5)
+    args=parser.parse_args()
+    evidence=json.loads((ROOT/'verification/plate_detector_diagnostic_20261030T040811_752788Z/plate_ground_truth_20261030/predictions_t640_20261030_163702_031951.json').read_text())
+    assert evidence['model']=='yolo-v9-t-640-license-plate-end2end'
+    images=[cv2.imread(str(ROOT/item['image'])) for item in evidence['images']]
+    with patch.object(socket.socket,'connect',side_effect=AssertionError('network denied')) as connect,patch.object(socket,'create_connection',side_effect=AssertionError('network denied')) as create:
+        detector=PlateDetector();started=time.perf_counter();detector.load();initialization=time.perf_counter()-started
+        for image in images:detector.predict(image)
+        rows=[]
+        for repeat in range(args.repeats):
+            for index,image in enumerate(images,1):
+                started=time.perf_counter();detections=detector.predict(image);elapsed=time.perf_counter()-started
+                rows.append({'repeat':repeat,'image_id':index,'milliseconds':elapsed*1000,'detections':len(detections)})
+        assert connect.call_count==create.call_count==0
+    times=[row['milliseconds'] for row in rows]
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps({'model':detector.metadata,'initialization_seconds':initialization,
+        'warmup_calls':len(images),'measurement_calls':len(rows),'mean_ms':statistics.mean(times),'median_ms':statistics.median(times),
+        'p95_ms':sorted(times)[min(len(times)-1,int(.95*len(times)))], 'peak_process_rss_bytes':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*1024,
+        'timing_boundary':'Synchronous complete adapter.predict call on already decoded original BGR; decode, model load and warm-up excluded. ORT.run returns CPU arrays synchronously. No classification/OCR.',
+        'network_attempts':0,'measurements':rows},indent=2)+'\n')
+
+
+if __name__=='__main__':main()
